RewriteEngine On
RewriteBase /

# Serve arquivos e diretórios reais normalmente (JS, CSS, imagens, etc.)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Qualquer outra rota cai no index.html (SPA — React Router cuida do resto)
RewriteRule ^ /index.html [L]
