# Copie este arquivo para .env.local e preencha com os dados do projeto
# Supabase. NUNCA commitar o .env.local (já está no .gitignore).
#
# A anon key é pública por natureza (fica embutida no bundle do
# frontend) — a proteção real dos dados fica nas policies de RLS e nas
# funções RPC do banco (ver supabase/migrations/0001_init.sql).
# A service role key NUNCA deve ir para o frontend.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-aqui
